// --- t distribution ---------------------------------------------------------
(function(){
  const df=999, pts=200;
  function tPDF(t,df){
    const B = Math.exp((df/2)*Math.log(df/2)-Math.lgamma(df/2)+(((df+1)/2)-1)*Math.log(1+(t*t)/df)-(df+1)/2*Math.log(1+(t*t)/df));
    // simpler approximation
    const a = Math.exp(Math.lgamma((df+1)/2)-Math.lgamma(df/2)-0.5*Math.log(Math.PI*df));
    return a * Math.pow(1 + t*t/df, -(df+1)/2);
  }
  if(!Math.lgamma) Math.lgamma = x => { const g=7,c=[0.99999999999980993,676.5203681218851,-1259.1392167224028,771.3234287776531,-176.6150291621406,12.507343278686905,-0.13857109526572012,9.984369578019572e-6,1.5056327351493116e-7]; let t=x+g-0.5,s=c[0]; for(let i=1;i<g+2;i++) s+=c[i]/(x+i-1); return 0.5*Math.log(2*Math.PI)+(x-0.5)*Math.log(t)-t+Math.log(s); };

  const xs=[], yFull=[], yRej=[];
  const tCrit=1.9623, tObs=-1.0702;
  for(let i=0;i<=pts;i++){
    const t = -4 + 8*i/pts;
    xs.push(t.toFixed(3));
    const p = tPDF(t,df);
    yFull.push(p);
    yRej.push((t<-tCrit||t>tCrit)?p:null);
  }
  const tObsIdx = Math.round((tObs+4)/8*pts);

  new Chart(document.getElementById('tC'),{
    type:'line',
    data:{
      labels: xs,
      datasets:[
        {label:'Curva t(999)', data:yFull, borderColor:'#378ADD', borderWidth:2, pointRadius:0, fill:true, backgroundColor:'rgba(55,138,221,0.08)', tension:.4},
        {label:'Região de rejeição', data:yRej, borderColor:'transparent', pointRadius:0, fill:true, backgroundColor:'rgba(216,90,48,0.35)', tension:.4},
        {label:'t observado', data:xs.map((_,i)=>i===tObsIdx?yFull[tObsIdx]:null), pointRadius:7, pointBackgroundColor:'#378ADD', showLine:false}
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{legend:{display:false}, tooltip:{callbacks:{label:c=>c.dataset.label}}},
      scales:{
        x:{ticks:{maxTicksLimit:9, color:tc, font:{size:10}}, grid:{color:gc}, border:{display:false}, title:{display:true, text:'Estatística t', color:tc, font:{size:10}}},
        y:{display:false}
      }
    }
  });
})();
