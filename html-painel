<style>
/* ── RESET ── */
*{box-sizing:border-box;margin:0;padding:0}

/* ── TOKENS — hardcoded dark theme ── */
:root{
  --bg:       #0d1117;
  --bg2:      #161b22;
  --bg3:      #21262d;
  --border:   #30363d;
  --border2:  #21262d;
  --txt:      #e6edf3;
