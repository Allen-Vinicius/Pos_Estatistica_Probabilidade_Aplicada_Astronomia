  --orange:   #F39C12;
  --crimson:  #E74C3C;
  --emerald:  #2ECC71;
  --scatter-n:rgba(133,193,233,0.38);
  --scatter-o:rgba(231,76,60,0.9);
}

body{
  font-family:'IBM Plex Sans',system-ui,sans-serif;
  background:var(--bg);
  color:var(--txt);
  min-height:100vh;
  font-size:14px;
  line-height:1.5;
}

.wrap{max-width:1100px;margin:0 auto;padding:0 1.25rem 3rem}

/* ── HERO ── */
.hero{
  padding:2.75rem 1rem 2.25rem;
  text-align:center;
  border-bottom:1px solid var(--border2);
  margin-bottom:2rem;
}
.hero-eye{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--txt4);margin-bottom:.55rem}
.hero-title{font-size:28px;font-weight:600;color:var(--txt);line-height:1.25}
.hero-title span{color:var(--gold)}
.hero-sub{font-size:14px;color:var(--txt3);margin-top:.6rem;line-height:1.6}
.params{display:flex;justify-content:center;flex-wrap:wrap;gap:10px;margin-top:1.25rem}
.chip{background:var(--bg2);border:1px solid var(--border);border-radius:99px;padding:.3rem 1rem;font-size:12px;color:var(--txt3);font-family:'IBM Plex Mono',monospace}
.chip b{color:var(--txt);font-weight:500}

/* ── SEC LABEL ── */
.sec{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--txt4);display:flex;align-items:center;gap:10px;margin-bottom:1rem}
.sec::after{content:'';flex:1;height:1px;background:var(--border2)}
.pad{padding:0}

/* ── KPI GRID ── */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px;margin-bottom:2rem}
.kpi{background:var(--bg2);border:1px solid var(--border2);border-radius:10px;padding:.9rem 1rem;position:relative}
.kpi-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--txt4);margin-bottom:.32rem}
.kpi-val{font-size:24px;font-weight:600;color:var(--txt);line-height:1;letter-spacing:-.02em;font-family:'IBM Plex Mono',monospace}
.kpi-sub{font-size:11px;color:var(--txt3);margin-top:.3rem}
.badge{position:absolute;top:.65rem;right:.65rem;font-size:10px;font-weight:600;padding:2px 8px;border-radius:99px;font-family:'IBM Plex Mono',monospace}
.bg{background:var(--green-bg);color:var(--green)}
.ba{background:var(--amber-bg);color:var(--amber)}
.bb{background:var(--blue-bg);color:var(--blue)}

/* ── IC BAR ── */
.ic-card{background:var(--bg2);border:1px solid var(--border2);border-radius:10px;padding:1.25rem 1.5rem;margin-bottom:2rem}
.ic-title{font-size:13px;font-weight:500;margin-bottom:.2rem}
.ic-sub{font-size:11px;color:var(--txt3);margin-bottom:1rem;font-family:'IBM Plex Mono',monospace}
.ic-track{position:relative;height:28px;background:var(--blue-bg);border-radius:6px;display:flex;align-items:center}
.ic-txt{position:absolute;font-size:10px;color:var(--blue);font-weight:600;font-family:'IBM Plex Mono',monospace}
.ic-pin{position:absolute;top:-6px;width:2.5px;height:40px;border-radius:1px}
.ic-lgnd{display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;font-size:11px;color:var(--txt3)}
.ic-dot{width:14px;height:3px;display:inline-block;border-radius:1px;vertical-align:middle;margin-right:4px}

/* ── CHARTS ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:2rem}
@media(max-width:640px){.g2{grid-template-columns:1fr}}
.card{background:var(--bg2);border:1px solid var(--border2);border-radius:10px;padding:1.1rem}
.card-t{font-size:13px;font-weight:500;margin-bottom:.15rem}
.card-s{font-size:11px;color:var(--txt3);margin-bottom:.75rem}
.lgnd{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:.7rem;font-size:11px;color:var(--txt3)}
.ld{width:10px;height:10px;border-radius:2px;display:inline-block;margin-right:3px}
.lv{width:2px;height:13px;display:inline-block;border-radius:1px;margin-right:3px;vertical-align:middle}
.cw{position:relative;height:220px}
.full{background:var(--bg2);border:1px solid var(--border2);border-radius:10px;padding:1.1rem 1.25rem;margin-bottom:2rem}

/* ── TABLE ── */
.tbl{width:100%;border-collapse:collapse;font-size:12px}
.tbl th{text-align:left;color:var(--txt4);font-weight:500;padding:.4rem .7rem;border-bottom:1px solid var(--border2);font-size:10px;text-transform:uppercase;letter-spacing:.05em}
.tbl td{padding:.5rem .7rem;border-bottom:1px solid var(--bg3);color:var(--txt2);font-family:'IBM Plex Mono',monospace;font-size:12px}
.tbl tr:last-child td{border-bottom:none}
.hi{color:var(--blue)!important;font-weight:600}
.lo{color:var(--green)!important;font-weight:600}
.wa{color:var(--amber)!important;font-weight:600}
.dr{color:var(--red)!important}
.mt{color:var(--txt4)!important}

/* ── FINDINGS ── */
.findings{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:2rem}
@media(max-width:640px){.findings{grid-template-columns:1fr}}
.f{border-radius:10px;padding:.9rem 1rem;border-left:3px solid}
.fg{background:var(--green-bg);border-color:#2ea043}
.fa{background:var(--amber-bg);border-color:#9e6a03}
.fb{background:var(--blue-bg);border-color:#388bfd}
.fc{background:var(--red-bg);border-color:#da3633}
.ft{font-size:12px;font-weight:600;margin-bottom:.28rem}
.fg .ft{color:var(--green)}.fa .ft{color:var(--amber)}.fb .ft{color:var(--blue)}.fc .ft{color:var(--red)}
.fb2{font-size:11px;line-height:1.55;color:var(--txt3)}

/* ── FLOW ── */
.flow{display:flex;border:1px solid var(--border2);border-radius:10px;overflow:hidden;margin-bottom:.5rem}
.step{flex:1;padding:.8rem .4rem;text-align:center;border-right:1px solid var(--border2)}
.step:last-child{border-right:none}
.step-n{font-size:17px;font-weight:600;color:var(--gold);font-family:'IBM Plex Mono',monospace}
.step-l{font-size:10px;color:var(--txt4);margin-top:.2rem;line-height:1.35}

/* ── PILL ROW ── */
.pill-row{display:flex;justify-content:center;gap:14px;margin-top:.85rem;flex-wrap:wrap}
.pill{display:flex;align-items:center;gap:7px;background:var(--bg3);border-radius:8px;padding:.38rem .9rem;font-size:11px}
.pill-bar{width:2px;height:15px;border-radius:1px;display:inline-block}
.pill-lbl{color:var(--txt3)}
.pill-val{font-weight:500;color:var(--txt);font-family:'IBM Plex Mono',monospace}
</style>
</head>
