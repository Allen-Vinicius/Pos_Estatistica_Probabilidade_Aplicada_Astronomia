(function(){
  Math.lgamma=function(x){
    const c=[.99999999999980993,676.5203681218851,-1259.1392167224028,771.3234287776531,-176.6150291621406,12.507343278686905,-.13857109526572012,9.984369578019572e-6,1.5056327351493116e-7];
    let t=x+6.5,s=c[0];for(let i=1;i<9;i++)s+=c[i]/(x+i-1);
    return .5*Math.log(2*Math.PI)+(x-.5)*Math.log(t)-t+Math.log(s);
  };
  const tPDF=(t,df)=>Math.exp(Math.lgamma((df+1)/2)-Math.lgamma(df/2)-.5*Math.log(Math.PI*df)-((df+1)/2)*Math.log(1+t*t/df));
  const df=999, tc=1.9623, to=-1.0702, NP=300;
  const xs=[],ya=[],yr=[];
  for(let i=0;i<=NP;i++){
