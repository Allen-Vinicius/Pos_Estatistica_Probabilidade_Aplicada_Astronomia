const dnorm=(x,mu,sd)=>Math.exp(-0.5*((x-mu)/sd)**2)/(sd*Math.sqrt(2*Math.PI));
const theor=mids.map(x=>parseFloat(dnorm(x,MU,SD).toFixed(5)));
const h=1.06*SD*Math.pow(N,-0.2);
const kde=mids.map(x=>{let s=0;OBS.forEach(xi=>s+=dnorm((x-xi)/h,0,1)/h);return parseFloat((s/N).toFixed(5))});

/* plugin linhas verticais x̄ e μ desenhadas direto no canvas */
const vlinePlugin={
  id:'vlines',
  afterDraw(chart){
    const{ctx,scales:{x,y}}=chart;
    const top=y.top, bot=y.bottom;
    const draw=(val,color,dash,tag,yOff)=>{
      const idx=lbls.reduce((b,l,i)=>Math.abs(parseFloat(l)-val)<Math.abs(parseFloat(lbls[b])-val)?i:b,0);
      const px=x.getPixelForValue(idx);
      ctx.save();
      ctx.setLineDash(dash); ctx.strokeStyle=color; ctx.lineWidth=2.5;
      ctx.beginPath(); ctx.moveTo(px,top); ctx.lineTo(px,bot); ctx.stroke();
      ctx.setLineDash([]);
      const pad=7, fh=15;
      ctx.font='500 11px "IBM Plex Mono",monospace';
      const fw=ctx.measureText(tag).width+pad*2;
      ctx.fillStyle=color;
      ctx.beginPath();
      if(ctx.roundRect) ctx.roundRect(px-fw/2,top+yOff,fw,fh,3);
      else ctx.rect(px-fw/2,top+yOff,fw,fh);
      ctx.fill();
      ctx.fillStyle= val===XBAR?'#0b2e15':'#3b1f00';
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText(tag,px,top+yOff+fh/2);
      ctx.restore();
    };
    draw(XBAR,'#2ECC71',[],'x̄ = 15,4713',4);
    draw(MU,'#F39C12',[5,4],'μ = 15,5000',23);
  }
};

