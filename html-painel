  --blue-bg:  #0d2045;
  --blue-txt: #a5c8ff;
  --green:    #56d364;
  --green-bg: #0d2114;
  --green-txt:#a7f3c0;
  --amber:    #d29922;
  --amber-bg: #1f1a0a;
  --amber-txt:#e3c87e;
  --red:      #ff7b72;
  --red-bg:   #200d0d;
  --red-txt:  #ffb3ae;
  --gold:     #f0c060;
  --chart-blue: rgba(27,79,114,0.78);
